{
  "name": "PHPirates patch approvals",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "seconds", "secondsInterval": 5 } ] }
      },
      "id": "poll",
      "name": "Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 240, 300 ]
    },
    {
      "parameters": {
        "url": "=http://approvals:5001/api/reviews",
        "options": {}
      },
      "id": "fetch",
      "name": "Get reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 460, 300 ]
    },
    {
      "parameters": { "fieldToSplitOut": "reviews", "options": {} },
      "id": "split",
      "name": "One per review",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 680, 300 ]
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "key",
        "options": {}
      },
      "id": "dedupe",
      "name": "Skip ones already seen",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 1.1,
      "position": [ 900, 300 ]
    },
    {
      "parameters": {
        "formTitle": "Approve patch?",
        "formFields": {
          "values": [
            { "fieldLabel": "server", "fieldType": "text" },
            { "fieldLabel": "vuln", "fieldType": "text" },
            { "fieldLabel": "diff", "fieldType": "textarea" },
            { "fieldLabel": "decision", "fieldType": "dropdown",
              "fieldOptions": { "values": [ { "option": "approve" }, { "option": "reject" } ] },
              "requiredField": true }
          ]
        },
        "options": {}
      },
      "id": "review",
      "name": "Human review (form)",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [ 1120, 300 ],
      "webhookId": "phpirates-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.decision }}", "rightValue": "approve", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "decide",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [ 1340, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://approvals:5001/api/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"key\": $('Skip ones already seen').item.json.key, \"reviewer\": \"n8n\" }",
        "options": {}
      },
      "id": "approve",
      "name": "POST approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1560, 200 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://approvals:5001/api/reject",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"key\": $('Skip ones already seen').item.json.key, \"reviewer\": \"n8n\", \"reason\": \"rejected in n8n\" }",
        "options": {}
      },
      "id": "reject",
      "name": "POST reject",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1560, 400 ]
    }
  ],
  "connections": {
    "Every 5s":            { "main": [ [ { "node": "Get reviews", "type": "main", "index": 0 } ] ] },
    "Get reviews":         { "main": [ [ { "node": "One per review", "type": "main", "index": 0 } ] ] },
    "One per review":      { "main": [ [ { "node": "Skip ones already seen", "type": "main", "index": 0 } ] ] },
    "Skip ones already seen": { "main": [ [ { "node": "Human review (form)", "type": "main", "index": 0 } ] ] },
    "Human review (form)": { "main": [ [ { "node": "Approved?", "type": "main", "index": 0 } ] ] },
    "Approved?":           { "main": [ [ { "node": "POST approve", "type": "main", "index": 0 } ], [ { "node": "POST reject", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
