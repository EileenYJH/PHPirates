{
  "name": "PHPirates n8n approver (simple)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "seconds", "secondsInterval": 5 } ] } },
      "id": "poll",
      "name": "Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 260, 300 ]
    },
    {
      "parameters": { "url": "=http://approvals:5001/api/reviews", "options": {} },
      "id": "fetch",
      "name": "Get pending reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 480, 300 ]
    },
    {
      "parameters": { "fieldToSplitOut": "reviews", "options": {} },
      "id": "split",
      "name": "One item per review",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 700, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://approvals:5001/api/approve",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "key", "value": "={{ $json.key }}" },
            { "name": "reviewer", "value": "n8n" }
          ]
        },
        "options": {}
      },
      "id": "approve",
      "name": "Approve as n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 920, 300 ]
    }
  ],
  "connections": {
    "Every 5s":            { "main": [ [ { "node": "Get pending reviews", "type": "main", "index": 0 } ] ] },
    "Get pending reviews": { "main": [ [ { "node": "One item per review", "type": "main", "index": 0 } ] ] },
    "One item per review": { "main": [ [ { "node": "Approve as n8n", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
