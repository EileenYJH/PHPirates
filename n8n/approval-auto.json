{
  "name": "PHPirates auto-approve (n8n in the loop)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "seconds", "secondsInterval": 5 } ] } },
      "id": "poll",
      "name": "Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 240, 300 ]
    },
    {
      "parameters": { "url": "=http://approvals:5001/api/reviews", "options": {} },
      "id": "fetch",
      "name": "Get pending reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 460, 300 ]
    },
    {
      "parameters": { "fieldToSplitOut": "reviews", "options": {} },
      "id": "split",
      "name": "One item per review",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 680, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.diff }}", "rightValue": "prepare(", "operator": { "type": "string", "operation": "contains" } },
            { "leftValue": "={{ $json.diff }}", "rightValue": "htmlspecialchars(", "operator": { "type": "string", "operation": "contains" } },
            { "leftValue": "={{ $json.diff }}", "rightValue": "in_array(", "operator": { "type": "string", "operation": "contains" } }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "policy",
      "name": "Patch looks like a real fix?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [ 900, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://approvals:5001/api/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ key: $json.key, reviewer: 'n8n', reason: 'policy: recognised a real fix' }) }}",
        "options": {}
      },
      "id": "approve",
      "name": "Approve (as n8n)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1140, 200 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://approvals:5001/api/reject",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ key: $json.key, reviewer: 'n8n', reason: 'policy: no recognised fix pattern' }) }}",
        "options": {}
      },
      "id": "reject",
      "name": "Reject (as n8n)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1140, 400 ]
    }
  ],
  "connections": {
    "Every 5s":                     { "main": [ [ { "node": "Get pending reviews", "type": "main", "index": 0 } ] ] },
    "Get pending reviews":          { "main": [ [ { "node": "One item per review", "type": "main", "index": 0 } ] ] },
    "One item per review":          { "main": [ [ { "node": "Patch looks like a real fix?", "type": "main", "index": 0 } ] ] },
    "Patch looks like a real fix?": { "main": [ [ { "node": "Approve (as n8n)", "type": "main", "index": 0 } ], [ { "node": "Reject (as n8n)", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
